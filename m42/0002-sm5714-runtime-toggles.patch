+static int m42_src_rp;
+module_param(m42_src_rp, int, 0644);
+MODULE_PARM_DESC(m42_src_rp, "m42: Rp on source attach: 0 keep, 1 default(80uA), 2 1.5A(180uA), 3 3A(330uA)");
