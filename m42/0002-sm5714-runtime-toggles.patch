 #include <linux/module.h>
 #include <linux/delay.h>
+#include <linux/moduleparam.h>
+
+/* m42: runtime experiment toggles, defaults = stock LineageOS behaviour */
+static bool m42_no_pd_src;
+module_param(m42_no_pd_src, bool, 0644);
+MODULE_PARM_DESC(m42_no_pd_src, "m42: no USB PD (no Source_Capabilities) when phone is source");
