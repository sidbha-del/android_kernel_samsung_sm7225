+		pr_info("m42diag: %s skipped\n", __func__);
+		return 0;
+	}
+
 	sm5714_usbpd_write_reg(i2c, SM5714_REG_USBK_CNTL, 0x80);
 	msleep(5);
 
@@ -2813,8 +2830,14 @@
